# ========================================
# API - ASP.NET Core Web API
# ========================================
!api/.gitignore

# ASP.NET Core / Visual Studio
**/bin/
**/obj/
**/bin\\*/
**/out/
**/PublishProfiles/
*.sln
*.suo
*.user
*.csproj.user
*.launchSettings.json
appsettings.*.json
*.db
*.sqlite
*.db-shm
*.db-wal

# ========================================
# WEB - Next.js
# ========================================
!web/.gitignore

# Node.js / Next.js
**/node_modules/
**/.next/
**/out/
**/build/
**/dist/
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
**/.vercel
**/.swc
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ========================================
# MOBILE - Flutter
# ========================================
!mobile/.gitignore

# Flutter / Dart
**/build/
**/.dart_tool/
**/.pub-cache/
**/.metadata
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/pubspec.lock

# Flutter iOS/Android
**/ios/Pods/
**/ios/Podfile.lock
**/ios/.symlinks/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/

# ========================================
# DOCS
# ========================================
!docs/.gitignore

# Docs klasörü (dokümantasyon)
**/node_modules
**/.env
docs/.vitepress/cache
docs/.vitepress/dist

# ========================================
# Diğer
# ========================================
coverage/
temp/
tmp/
*.pid
*.seed