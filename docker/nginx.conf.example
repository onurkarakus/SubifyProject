# Subify OS — Nginx reverse proxy example (Faz 11.1.5)
# Point `upstream` hosts at compose service names when Nginx is on the same network.

upstream subify_web {
    server web:3000;
}

upstream subify_api {
    server api:8080;
}

server {
    listen 80;
    server_name subify.example.com;  # change me

    # Redirect to HTTPS in production (after cert setup)
    # return 301 https://$host$request_uri;

    client_max_body_size 10m;

    # 14.1.4 — security headers (HSTS only on the TLS server block)
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # API — keep /api prefix (matches Subify.Api routes)
    location /api/ {
        proxy_pass http://subify_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    # Health (optional direct)
    location = /health {
        proxy_pass http://subify_api/health;
        proxy_set_header Host $host;
    }

    location = /health/ready {
        proxy_pass http://subify_api/health/ready;
        proxy_set_header Host $host;
    }

    # Web (Next.js)
    location / {
        proxy_pass http://subify_web;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# TLS sketch (certbot / mounted certs):
# server {
#   listen 443 ssl http2;
#   ssl_certificate     /etc/ssl/certs/fullchain.pem;
#   ssl_certificate_key /etc/ssl/private/privkey.pem;
