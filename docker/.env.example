# Subify OS Docker environment
#   cp .env.example .env
#   docker compose up -d --build

# --- Postgres ---
POSTGRES_USER=subify_admin
# Local/dev default (aligned with appsettings + compose). Change in production.
POSTGRES_PASSWORD=SecretPassword123!
POSTGRES_DB=subify_db
POSTGRES_PORT=5432

# --- API ---
API_PORT=5240
ASPNETCORE_ENVIRONMENT=Production
# MUST be long enough for HS256 (>= 32 chars). Change in production.
JWT_SECRET_KEY=SuperSecretKeyForSubifyOsProjectWhichNeedsToBeLongEnough
JWT_ISSUER=SubifyOS
JWT_AUDIENCE=SubifyOSClient
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_DAYS=7

# --- Web (browser-facing URLs) ---
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
WEB_ORIGIN_ALT=http://127.0.0.1:3000
# URL the browser uses to call the API (include /api)
NEXT_PUBLIC_API_URL=http://localhost:5240/api

# Behind reverse proxy (Caddy/Nginx) example:
# WEB_ORIGIN=https://subify.example.com
# NEXT_PUBLIC_API_URL=https://subify.example.com/api

# --- Optional FX ---
EXCHANGE_RATES_ENABLED=true
EXCHANGE_RATES_INTERVAL=1h
BACKGROUND_JOBS_ENABLED=true
EXCHANGE_RATE_API_KEY=

# Host-run API connection string (dotnet run on host, DB in Docker only):
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=subify_db;Username=subify_admin;Password=ChangeMe_UseAStrongPassword!
