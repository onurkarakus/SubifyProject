# Subify OS — local Postgres (task 2.3.11)
# Copy to docker/.env if you need overrides (gitignored).
# Must stay aligned with:
#   api/Subify.Api/appsettings.Development.json → ConnectionStrings:DefaultConnection
#   api/Subify.Api/appsettings.json               → ConnectionStrings:DefaultConnection (fallback)

POSTGRES_USER=subify_admin
POSTGRES_PASSWORD=SecretPassword123!
POSTGRES_DB=subify_db
POSTGRES_PORT=5432

# Npgsql connection string for host-run API (dotnet run on host, DB in Docker):
# Host=localhost;Port=5432;Database=subify_db;Username=subify_admin;Password=SecretPassword123!
