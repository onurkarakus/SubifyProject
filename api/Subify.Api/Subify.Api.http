### ---------------------------------------------------------------------------
### Admin · Users (Faz 7.1)
### ---------------------------------------------------------------------------

# @name listAdminUsers
GET {{host}}/api/admin/users?page=1&pageSize=20&search=
Authorization: Bearer {{accessToken}}
Accept: application/json

###

# @name createAdminUser
POST {{host}}/api/admin/users
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}
Accept: application/json

{
  "email": "member@example.com",
  "fullName": "Family Member",
  "password": "Password1",
  "role": "User"
}

###

@adminUserId = {{createAdminUser.response.body.$.id}}

# @name patchAdminUserLock
PATCH {{host}}/api/admin/users/{{adminUserId}}
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}
Accept: application/json

{
  "isLocked": true
}

###

# @name patchAdminUserDisable
PATCH {{host}}/api/admin/users/{{adminUserId}}
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}
Accept: application/json

{
  "isDisabled": true
}

###

# @name patchAdminUserRole
PATCH {{host}}/api/admin/users/{{adminUserId}}
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}
Accept: application/json

{
  "role": "Admin",
  "isLocked": false,
  "isDisabled": false
}

###

# @name adminResetPassword
# 7.5.1 — Şifre sıfırla (admin users table action)
POST {{host}}/api/admin/users/{{adminUserId}}/reset-password
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}
Accept: application/json

{
  "newPassword": "NewPassword1"
}


